.DS_Store

# Local config and secrets. Runtime API keys should live outside the repo,
# e.g. ~/.config/pdflite/config.json.
/.config/
/config.local.json
/Secrets.swift

# Optional/reference scratch clones. Canonical AI references live in references/
# as git submodules.
/references_optional/

# Xcode local state
DerivedData/
*.xcuserdata/
*.xcuserstate

# Generated by xcodegen — keep project.yml as source of truth
PDFLite.xcodeproj/

# Swift Package build artefacts
.build/
.swiftpm/
Package.resolved
